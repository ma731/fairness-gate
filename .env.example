# Copy this file to .env and fill it in. .env is git-ignored and never leaves your machine.
# Then test it with:  python scripts/narrate.py --check

# azure-openai  an OpenAI model deployed on Azure (cheapest to start with)
# azure-claude  a Claude model deployed on Azure AI Foundry
# anthropic     the Claude API directly (console.anthropic.com)
NARRATOR_PROVIDER=azure-openai

# Azure: your resource > Keys and Endpoint > KEY 1.  Anthropic: your API key.
NARRATOR_API_KEY=

# Azure: the deployment name you gave the model (Foundry > Deployments).
# Anthropic: a model id such as claude-opus-5.
NARRATOR_MODEL=

# azure-openai only: the Endpoint shown on the Keys and Endpoint page.
AZURE_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_API_VERSION=2024-10-21

# azure-claude only: the resource name.
AZURE_RESOURCE=your-resource-name
